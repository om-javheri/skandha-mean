{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/digital-first-services",
      "destination": "/digital-first-services/",
      "permanent": true
    },
    {
      "source": "/ai-ml-for-media",
      "destination": "/ai-ml-for-media/",
      "permanent": true
    },
    {
      "source": "/customized-solutions",
      "destination": "/customized-solutions/",
      "permanent": true
    },
    {
      "source": "/digital-sports-operations",
      "destination": "/digital-sports-operations/",
      "permanent": true
    },
    {
      "source": "/managed-media-fabric",
      "destination": "/managed-media-fabric/",
      "permanent": true
    },
    {
      "source": "/vidre",
      "destination": "/vidre/",
      "permanent": true
    },
    {
      "source": "/media-capability-centres",
      "destination": "/media-capability-centres/",
      "permanent": true
    },
    {
      "source": "/media-verticals",
      "destination": "/media-verticals/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/news/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_embeds/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox"
        }
      ]
    }
  ]
}
